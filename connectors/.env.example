# Databricks (Zerobus endpoint is derived: https://<workspace-id>.zerobus.<region>.cloud.databricks.com)
DATABRICKS_WORKSPACE_URL=https://{workspace-url}
DATABRICKS_WORKSPACE_ID=<workspace-id>
DATABRICKS_REGION=<aws-region>
DATABRICKS_CLIENT_ID=<service-principal-app-id>
DATABRICKS_CLIENT_SECRET=<service-principal-secret>
DATABRICKS_TABLE_NAME=<catalog>.<schema>.vehicle_positions
DATABRICKS_TRIP_UPDATES_TABLE_NAME=<catalog>.<schema>.trip_updates

# Translink (optional — defaults to SEQ endpoints)
TRANSLINK_API_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/VehiclePositions
TRANSLINK_TRIP_UPDATES_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/TripUpdates

# Logging (optional)
LOG_LEVEL=INFO
