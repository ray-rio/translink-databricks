# Generated from config.yml — do not edit directly.
# Run: uv run scripts/sync_config.py

# Databricks (Zerobus endpoint is derived: https://<workspace-id>.zerobus.<region>.cloud.databricks.com)
DATABRICKS_WORKSPACE_URL=https://<workspace>.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=<workspace-id>
DATABRICKS_REGION=ap-southeast-2
DATABRICKS_CLIENT_ID=<service-principal-app-id>
DATABRICKS_CLIENT_SECRET=<service-principal-secret>
DATABRICKS_TABLE_NAME=<catalog-name>.<schema-name>.raw_vehicle_positions
DATABRICKS_TRIP_UPDATES_TABLE_NAME=<catalog-name>.<schema-name>.raw_trip_updates

# Translink
TRANSLINK_API_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/VehiclePositions
TRANSLINK_TRIP_UPDATES_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/TripUpdates

# GTFS Static (gtfs-static connector)
DATABRICKS_VOLUME_PATH=/Volumes/<catalog-name>/<schema-name>/gtfs_static
TRANSLINK_GTFS_STATIC_URL=https://gtfsrt.api.translink.com.au/GTFS/SEQ_GTFS.zip

# Logging
LOG_LEVEL=INFO
