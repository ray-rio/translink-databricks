# =============================================================================
# SAM deployment configuration.
#
# Copy to samconfig.toml and fill in your values:
#   cp samconfig.toml.example samconfig.toml
#
# Then deploy with:
#   sam build && sam deploy
#
# Or run `sam deploy --guided` to create samconfig.toml interactively.
# =============================================================================

version = 0.1

[default.build.parameters]
cached = true

[default.deploy.parameters]
stack_name = "transit-connector"
resolve_s3 = true
s3_prefix = "transit-connector"
region = "ap-southeast-2"
capabilities = "CAPABILITY_IAM"
confirm_changeset = true

parameter_overrides = [
    "DatabricksWorkspaceUrl=https://dbc-xxx.cloud.databricks.com",
    "DatabricksWorkspaceId=<workspace-id>",
    "DatabricksRegion=ap-southeast-2",
    "DatabricksClientId=<service-principal-app-id>",
    "DatabricksClientSecret=<service-principal-secret>",
    "DatabricksVehiclePositionsTableName=<catalog>.<schema>.vehicle_positions",
    "DatabricksTripUpdatesTableName=<catalog>.<schema>.trip_updates",
]
